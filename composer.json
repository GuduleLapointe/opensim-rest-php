{
    "name": "magicoli/opensim-rest-php",
    "description": "OpenSimulator REST PHP library and command-line client",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Gudule Lapointe",
            "email": "gudule@speculoos.world"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "magicoli/pest-failure-summary": "^1.0",
        "pestphp/pest": "^3.0",
        "phpcompatibility/php-compatibility": "dev-develop",
        "squizlabs/php_codesniffer": "^4.0",
        "magicoli/bash-tools": "^1.0.6"
    },
    "autoload": {
        "files": [
            "class-rest.php"
        ]
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev"
}
