# What a distribution of the project leaves out, among what git tracks (the zip, the Debian package, and its copy in the
# vendor folder of another project; what .gitignore ignores is not there to begin with): /name is at the root, name is
# anywhere, a glob is fine
/.distignore
/.editorconfig
/DEVELOPERS.md
/.gitignore
/.php-version
/.prettierignore
/.prettierrc.json
/dev
/packaging
/phpcs.xml.dist
/phpunit.xml
/tests
