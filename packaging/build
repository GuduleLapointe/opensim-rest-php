#!/usr/bin/env bash
# Prepares what the Debian package installs, in build/opensim-rest-php: the files of packaging/files as committed (HEAD),
# not the tests nor the development tools. Run by apt-package from the project root, or by dev/build.sh.
# The version goes to build/packaging.env.

set -e
cd "$(dirname "$0")/.."

mkdir -p build
packaging/version >build/packaging.env

BUILD=build/opensim-rest-php
rm -rf "$BUILD"
mkdir -p "$BUILD"
# shellcheck disable=SC2046
git archive HEAD $(cat packaging/files) | tar -x -C "$BUILD"
chmod -R u+rwX,go+rX,go-w "$BUILD"
